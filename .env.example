ANTHROPIC_API_KEY=your_anthropic_api_key

# You.com API key
YDC_API_KEY=your_you_com_api_key

# Optional: enable LangSmith tracing.
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://aws.api.smith.langchain.com # this may be different for your region
LANGSMITH_API_KEY=<your-api-key>
LANGSMITH_PROJECT="Deep Agents deep research agent" # this is the project name you will see in LangSmith

RESEARCH_QUESTION="What are the main differences between RAG and fine-tuning for enterprise LLM applications?" # the research prompt to supply to the agent
